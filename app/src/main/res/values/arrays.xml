        <item>com.heytap.mydevices</item>
        <item>com.mi.health</item>
        <item>com.coloros.alarmclock</item>
        <item>com.oneplus.deskclock</item>
        <item>net.oneplus.weather</item>
        <item>com.coloros.weather.service</item>
    </string-array>
</resources>
